# ── Backend REST de SWAC ──────────────────────────────────────────────────────
# URL base usada por el adaptador "API real" (Axios). Se puede cambiar en
# runtime desde Configuración › Sistema (se persiste en localStorage).
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1

# ── Origen de datos inicial ───────────────────────────────────────────────────
# MOCK     → repositorios en memoria con datos de demostración (sin backend)
# LIVE_API → peticiones HTTP reales contra NEXT_PUBLIC_API_URL
NEXT_PUBLIC_DATA_SOURCE_MODE=MOCK
